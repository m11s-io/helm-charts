{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "UTC",
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "helm-values": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Chart appVersion annotated with Renovate hints",
      "managerFilePatterns": [
        "/^charts/.+/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\nappVersion:\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Pinned CI tool versions annotated with Renovate hints",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s+\"?(?<currentValue>[^\"\\s]+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n[^\\n]*--version[= ](?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Keep Artifact Hub image references synchronized with chart values",
      "managerFilePatterns": [
        "/^charts\\/(comfyui|decap-cms|dub)\\/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>m11s/(?:comfyui|comfy-mcp|decap-cms|s3-upload-proxy|redis-http-proxy)):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "chart-image",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "appVersion and pinned CI tool versions are plain strings, not image references -- never append a digest",
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": false
    },
    {
      "description": "Track Helm image values only for the maintained images in the affected charts",
      "matchManagers": [
        "helm-values"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "charts/comfyui/values.yaml",
        "charts/decap-cms/values.yaml",
        "charts/dub/values.yaml"
      ],
      "matchPackageNames": [
        "m11s/comfyui",
        "m11s/comfy-mcp",
        "m11s/decap-cms",
        "m11s/s3-upload-proxy",
        "m11s/redis-http-proxy"
      ],
      "enabled": true,
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Artifact Hub references are full image references and must retain digest pins",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "chart-image"
      ],
      "pinDigests": true
    },
    {
      "description": "Compare Docker application tags using their compatibility suffixes",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "charts/comfyui/**",
        "charts/decap-cms/**",
        "charts/dub/**"
      ],
      "versioning": "docker"
    },
    {
      "description": "Update image values, appVersion, and image metadata together",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "charts/comfyui/**"
      ],
      "groupName": "comfyui chart images",
      "automerge": false
    },
    {
      "description": "Update image values, appVersion, and image metadata together",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "charts/decap-cms/**"
      ],
      "groupName": "decap-cms chart images",
      "automerge": false
    },
    {
      "description": "Update image values, appVersion, and image metadata together",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "charts/dub/**"
      ],
      "groupName": "dub chart images",
      "automerge": false
    },
    {
      "description": "SearXNG publishes date-stamped tags with a git SHA suffix; the SHA is not orderable, so it is matched but excluded from comparison",
      "matchPackageNames": [
        "searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-.+)?$"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "labels": [
        "dependencies",
        "automerge"
      ],
      "description": "Automerge only CI tool pins. Chart appVersion and subchart bumps are deliberately excluded: chart-releaser publishes on Chart.yaml version and skips versions it has already released, so an automerged chart edit would land without ever being published",
      "matchFileNames": [
        ".github/workflows/**"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Automerge maintained chart image digest updates after checks pass; override the manual-merge defaults above without enabling tag upgrades",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "charts/comfyui/**",
        "charts/decap-cms/**",
        "charts/dub/**"
      ],
      "matchPackageNames": [
        "m11s/comfyui",
        "m11s/comfy-mcp",
        "m11s/decap-cms",
        "m11s/s3-upload-proxy",
        "m11s/redis-http-proxy"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": "ct lint requires a chart version bump on every chart change and chart-releaser publishes on chart version, so an appVersion-only PR can never be released. The regex is deliberately unanchored: Renovate compiles matchStrings without the multiline flag, so ^ would mean start-of-file and never match. It still picks the chart version because apiVersion has a capital V and exec() without /g returns the first hit, which precedes any dependency version.",
      "matchFileNames": [
        "charts/**"
      ],
      "bumpVersions": [
        {
          "name": "chart version",
          "filePatterns": [
            "{{packageFileDir}}/Chart.{yaml,yml}"
          ],
          "matchStrings": [
            "version:\\s(?<version>[^\\s]+)"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
