{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "fider": {
      "type": "object",
      "properties": {
        "baseURL": { "type": "string" },
        "hostMode": {
          "type": "string",
          "enum": ["single", "multi"]
        },
        "hostDomain": { "type": "string" },
        "logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"]
        },
        "existingSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "jwtSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "db": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "urlKey": { "type": "string", "minLength": 1 }
          }
        },
        "maxIdleConns": { "type": "integer", "minimum": 0 },
        "maxOpenConns": { "type": "integer", "minimum": 1 }
      }
    },
    "blobStorage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sql", "s3", "fs"]
        }
      }
    },
    "email": {
      "type": "object",
      "properties": {
        "noreply": { "type": "string" },
        "smtp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "mailgun": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "domain": { "type": "string" },
            "region": {
              "type": "string",
              "enum": ["US", "EU"]
            }
          }
        },
        "awsses": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "region": { "type": "string" }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "group": { "type": "string" },
              "kind": { "type": "string" },
              "namespace": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "sectionName": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "additionalProperties": true
          }
        },
        "hostnames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["parentRefs"],
        "properties": {
          "parentRefs": { "minItems": 1 }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayNamespace": { "type": "string" },
        "databaseNamespace": { "type": "string" },
        "databasePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "internetEgress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "cidr": { "type": "string" },
            "except": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dnsEgress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    }
  }
}
