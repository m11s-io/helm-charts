                "disableIp": {
                    "type": "boolean"
                },
                "disableReferrer": {
                    "type": "boolean"
                },
                "disableTrackParam": {
                    "type": "string"
                },
                "disableUa": {
                    "type": "boolean"
                },
                "disabled": {
                    "type": "boolean"
                },
                "orphanVisits": {
                    "type": "boolean"
                }
            }
