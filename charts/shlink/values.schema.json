                }
            }
        },
        "db": {
            "type": "object",
            "properties": {
                "driver": {
                    "type": "string"
                },
                "existingSecret": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "passwordKey": {
                            "type": "string"
                        }
                    }
                },
                "host": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "type": "string"
