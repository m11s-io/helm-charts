{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "affinity": {
            "type": "object"
        },
        "decapCms": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer"
                },
                "tenantsFile": {
                    "type": "string"
                }
            }
        },
        "existingTenantsConfigMap": {
            "type": "string"
        },
        "existingTenantsPersistentVolumeClaim": {
            "type": "string"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "httpRoute": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "enabled": {
                    "type": "boolean"
                },
                "hostnames": {
                    "type": "array"
                },
                "labels": {
                    "type": "object"
                },
                "parentRefs": {
                    "type": "array"
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "podAnnotations": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                }
            }
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "add": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "tenants": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "gitlabAppId": {
                        "type": "string"
                    },
                    "gitlabBranch": {
                        "type": "string"
                    },
                    "gitlabRepo": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "uploadUrl": {
                        "type": "string"
                    }
                }
            }
        },
        "tolerations": {
            "type": "array"
        },
        "uploadProxy": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "existingSecret": {
                    "type": "string"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "s3": {
                    "type": "object",
                    "properties": {
                        "bucket": {
                            "type": "string"
                        },
                        "endpoint": {
                            "type": "string"
                        },
                        "keyPrefix": {
                            "type": "string"
                        },
                        "publicUrl": {
                            "type": "string"
                        },
                        "region": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
