{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "affinity": {
            "type": "object"
        },
        "env": {
            "type": "object"
        },
        "extraEnv": {
            "type": "array"
        },
        "extraEnvFrom": {
            "type": "array"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "httpRoute": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "enabled": {
                    "type": "boolean"
                },
                "hostnames": {
                    "type": "array"
                },
                "labels": {
                    "type": "object"
                },
                "parentRefs": {
                    "type": "array"
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "limiter": {
            "type": "object",
            "properties": {
                "blockIP": {
                    "type": "array"
                },
                "enabled": {
                    "type": "boolean"
                },
                "extraConfig": {
                    "type": "string"
                },
                "filterLinkLocal": {
                    "type": "boolean"
                },
                "ipv4Prefix": {
                    "type": "integer"
                },
                "ipv6Prefix": {
                    "type": "integer"
                },
                "linkToken": {
                    "type": "boolean"
                },
                "passIP": {
                    "type": "array"
                },
                "passSearxngOrg": {
                    "type": "boolean"
                },
                "trustedProxies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "networkPolicy": {
            "type": "object",
            "properties": {
                "dnsEgress": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "gatewayNamespace": {
                    "type": "string"
                },
                "internetEgress": {
                    "type": "object",
                    "properties": {
                        "cidr": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "except": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "valkeyPort": {
                    "type": "integer"
                }
            }
        },
        "nodeSelector": {
            "type": "object"
        },
        "persistence": {
            "type": "object",
            "properties": {
                "accessMode": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "existingClaim": {
                    "type": "string"
                },
                "size": {
                    "type": "string"
                },
                "storageClass": {
                    "type": "string"
                }
            }
        },
        "podAnnotations": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "fsGroup": {
                    "type": "integer"
                }
            }
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "searxng": {
            "type": "object",
            "properties": {
                "baseURL": {
                    "type": "string"
                },
                "debug": {
                    "type": "boolean"
                },
                "existingSecret": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "secretKeyKey": {
                            "type": "string"
                        }
                    }
                },
                "formats": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "imageProxy": {
                    "type": "boolean"
                },
                "instanceName": {
                    "type": "string"
                },
                "method": {
                    "type": "string"
                },
                "publicInstance": {
                    "type": "boolean"
                },
                "settings": {
                    "type": "object"
                }
            }
        },
        "securityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "array"
        },
        "valkey": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "existingSecret": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "urlKey": {
                            "type": "string"
                        }
                    }
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}
